# Alpaca paper-trading credentials.
# Create at https://alpaca.markets → Paper Trading → API Keys.
# Options Level 3 must be enabled on the account for vertical spreads.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Paper by default. This is also what the MCP server itself reads.
# Set to false only for a live-money account.
ALPACA_PAPER_TRADE=true

# LLM provider. At least ONE of these is required; the chain is configured in
# config/agent_config.json and falls over automatically on a 429 or 5xx.
#
# Primary. The model is chosen empirically — see spikes/gate_stage2.py --survey,
# which round-trips a two-tool schema through every free tool-calling model.
OPENROUTER_API_KEY=

# First fallback. Fast, generous free limits, reliable tool calling.
GROQ_API_KEY=

# Second fallback.
GEMINI_API_KEY=
